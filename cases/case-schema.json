{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stitchedpatient.dev/schemas/case.json",
  "title": "Stitched Patient Case Definition",
  "description": "Schema for case definition files in Stitched Patient simulation",
  "type": "object",
  "required": ["id", "title", "patient", "engine", "timeline", "alarms", "interventions", "references"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique case identifier (lowercase-with-hyphens)",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable case title"
    },
    "patient": {
      "type": "object",
      "description": "Patient demographics and presentation",
      "required": ["age", "sex", "summary"],
      "properties": {
        "age": {
          "type": "integer",
          "minimum": 0
        },
        "sex": {
          "type": "string",
          "enum": ["male", "female", "other"]
        },
        "summary": {
          "type": "string",
          "description": "One-line chief complaint or presentation"
        }
      }
    },
    "engine": {
      "type": "object",
      "description": "Pulse engine configuration",
      "required": ["startingState"],
      "properties": {
        "startingState": {
          "type": "string",
          "description": "Path to Pulse engine starting state file"
        }
      }
    },
    "timeline": {
      "type": "object",
      "description": "Scheduled events in the simulation",
      "required": ["scheduledInsults"],
      "properties": {
        "scheduledInsults": {
          "type": "array",
          "description": "List of pathological events that occur at specific times",
          "items": {
            "type": "object",
            "required": ["timeSeconds", "action", "parameters"],
            "properties": {
              "timeSeconds": {
                "type": "number",
                "minimum": 0,
                "description": "When this insult occurs (simulation time)"
              },
              "action": {
                "type": "string",
                "description": "Pulse action class name (e.g., SETensionPneumothorax)"
              },
              "parameters": {
                "type": "object",
                "description": "Action-specific parameters",
                "properties": {
                  "side": {
                    "type": "string",
                    "enum": ["Left", "Right"]
                  },
                  "type": {
                    "type": "string",
                    "enum": ["Closed", "Open"]
                  },
                  "severity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "alarms": {
      "type": "object",
      "description": "Vital sign alarm thresholds",
      "required": ["heartRate", "respiratoryRate", "spO2", "meanArterialPressure"],
      "properties": {
        "heartRate": {
          "$ref": "#/definitions/thresholds"
        },
        "respiratoryRate": {
          "$ref": "#/definitions/thresholds"
        },
        "spO2": {
          "$ref": "#/definitions/thresholds"
        },
        "meanArterialPressure": {
          "$ref": "#/definitions/thresholds"
        },
        "etCO2": {
          "$ref": "#/definitions/thresholds"
        },
        "tidalVolume": {
          "$ref": "#/definitions/thresholds"
        }
      }
    },
    "interventions": {
      "type": "array",
      "description": "Available interventions for this case",
      "items": {
        "type": "object",
        "required": ["id", "label", "action"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique intervention identifier"
          },
          "label": {
            "type": "string",
            "description": "Display label for UI button"
          },
          "action": {
            "type": "string",
            "description": "Pulse action class name"
          },
          "parameters": {
            "type": "object",
            "description": "Fixed or configurable parameters"
          },
          "playLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "action": { "const": "SENeedleDecompression" } },
              "required": ["action"]
            },
            "then": {
              "required": ["parameters"],
              "properties": {
                "parameters": {
                  "type": "object",
                  "required": ["side", "state"],
                  "properties": {
                    "side": { "enum": ["Left", "Right"] },
                    "state": { "enum": ["On", "Off"] }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "play": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalText", "endings", "hints", "status", "diagnosisTerms"],
      "properties": {
        "goalText": { "type": "string", "minLength": 1, "maxLength": 120 },
        "diagnosisTerms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "avatar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "referenceTidalVolumeMl": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "references": { "$ref": "#/definitions/citationList" },
        "endings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rescued", "lost"],
          "properties": {
            "rescued": {
              "type": "object",
              "additionalProperties": false,
              "required": ["conditions", "holdSeconds"],
              "properties": {
                "conditions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": { "$ref": "#/definitions/vitalCondition" }
                },
                "holdSeconds": { "type": "number", "exclusiveMinimum": 0 },
                "requiredInterventions": { "$ref": "#/definitions/requiredInterventionList" },
                "references": { "$ref": "#/definitions/citationList" }
              }
            },
            "lost": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "groups": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 5,
                  "items": { "$ref": "#/definitions/conditionGroup" }
                },
                "timeLimitSeconds": { "type": "number", "exclusiveMinimum": 0 },
                "references": { "$ref": "#/definitions/citationList" }
              },
              "anyOf": [
                { "required": ["groups"], "properties": { "groups": { "minItems": 1 } } },
                { "required": ["timeLimitSeconds"] }
              ]
            }
          }
        },
        "hints": { "$ref": "#/definitions/hintList" },
        "exam": { "$ref": "#/definitions/examSection" },
        "sideRevealText": { "$ref": "#/definitions/sideRevealText" },
        "speech": { "$ref": "#/definitions/speechSection" },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules", "defaultSentence"],
          "properties": {
            "defaultSentence": { "type": "string", "minLength": 1, "maxLength": 80 },
            "rules": {
              "type": "array",
              "minItems": 0,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["when", "sentence"],
                "properties": {
                  "when": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": { "$ref": "#/definitions/statusWhen" }
                  },
                  "sentence": { "type": "string", "minLength": 1, "maxLength": 80 }
                }
              }
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": { "$ref": "#/definitions/variant" }
    },
    "references": {
      "type": "array",
      "description": "Clinical sources for case content",
      "items": {
        "type": "object",
        "required": ["citation"],
        "properties": {
          "citation": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "definitions": {
    "hintList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 160 },
          "references": { "$ref": "#/definitions/citationList" }
        }
      }
    },
    "requiredInterventionList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sideRevealText": { "type": "string", "minLength": 1, "maxLength": 120 },
    "kebabId": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9-]+$" },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "overrides"],
      "properties": {
        "id": { "$ref": "#/definitions/kebabId" },
        "overrides": { "$ref": "#/definitions/variantOverrides" }
      }
    },
    "variantOverrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "insultSide": { "type": "string", "enum": ["Left", "Right"] },
        "requiredInterventions": { "$ref": "#/definitions/requiredInterventionList" },
        "hints": { "$ref": "#/definitions/hintList" },
        "sideRevealText": { "$ref": "#/definitions/sideRevealText" }
      }
    },
    "examSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": { "$ref": "#/definitions/examAction" }
        },
        "references": { "$ref": "#/definitions/citationList" }
      }
    },
    "examLabel": { "type": "string", "minLength": 1, "maxLength": 60 },
    "examAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rules", "defaultSentence"],
      "properties": {
        "id": { "$ref": "#/definitions/kebabId" },
        "label": { "$ref": "#/definitions/examLabel" },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Left", "Right"],
          "properties": {
            "Left": { "$ref": "#/definitions/examLabel" },
            "Right": { "$ref": "#/definitions/examLabel" }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": { "$ref": "#/definitions/examRule" }
        },
        "defaultSentence": { "type": "string", "minLength": 1, "maxLength": 100 },
        "references": { "$ref": "#/definitions/citationList" }
      },
      "oneOf": [
        { "required": ["label"] },
        { "required": ["labels"] }
      ],
      "if": { "required": ["label"] },
      "then": {
        "properties": {
          "rules": { "items": { "properties": { "when": { "not": { "required": ["side"] } } } } }
        }
      }
    },
    "examRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "sentence"],
      "properties": {
        "when": { "$ref": "#/definitions/examWhen" },
        "sentence": { "type": "string", "minLength": 1, "maxLength": 100 },
        "abnormal": { "type": "boolean" }
      }
    },
    "examWhen": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "side": { "enum": ["affected", "other"] },
        "insult": { "enum": ["started", "notStarted"] },
        "decompressed": { "type": "boolean" },
        "vitals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/definitions/statusWhen" }
        }
      }
    },
    "vitalName": {
      "enum": ["heartRate", "respiratoryRate", "spO2", "meanArterialPressure", "etCO2", "tidalVolume"]
    },
    "citationList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "speechLineList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "speechSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sentence", "lines"],
            "properties": {
              "sentence": { "type": "string", "minLength": 1, "maxLength": 80 },
              "lines": { "$ref": "#/definitions/speechLineList" }
            }
          }
        },
        "early": { "$ref": "#/definitions/speechLineList" },
        "rescued": { "$ref": "#/definitions/speechLineList" },
        "forbiddenTerms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "references": { "$ref": "#/definitions/citationList" }
      }
    },
    "vitalCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vital", "op", "value"],
      "properties": {
        "vital": { "$ref": "#/definitions/vitalName" },
        "op": { "enum": ["<", "<=", ">=", ">"] },
        "value": { "type": "number", "minimum": 0 }
      },
      "if": { "properties": { "vital": { "const": "spO2" } } },
      "then": { "properties": { "value": { "maximum": 1 } } }
    },
    "conditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "holdSeconds"],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/definitions/vitalCondition" }
        },
        "holdSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "statusWhen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vital", "band"],
      "properties": {
        "vital": { "$ref": "#/definitions/vitalName" },
        "band": { "enum": ["normal", "warning", "critical"] },
        "direction": { "enum": ["low", "high"] }
      },
      "if": { "properties": { "band": { "const": "normal" } } },
      "then": { "not": { "required": ["direction"] } }
    },
    "thresholds": {
      "type": "object",
      "required": ["critical", "warning", "normal"],
      "properties": {
        "critical": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            }
          }
        },
        "warning": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            }
          }
        },
        "normal": {
          "type": "object",
          "required": ["low", "high"],
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
