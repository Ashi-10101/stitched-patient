# Physiology Service
PULSE_DATA_ROOT=/pulse/bin

# Session management (physiology service)
# Maximum checkpoints kept per branch before the oldest is evicted (10-1000, default 100)
MAX_CHECKPOINTS_PER_BRANCH=100
# Seconds a session with no WebSocket subscribers may stay idle before release (positive integer, default 3600)
SESSION_IDLE_TIMEOUT=3600
# Seconds allowed for Pulse engine initialization when creating a session (positive integer, default 30)
SESSION_CREATION_TIMEOUT=30

# Web Application
NEXT_PUBLIC_PHYSIOLOGY_URL=http://localhost:8000

# LLM Configuration (for future patient dialog feature)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4
# LLM_API_KEY=your-api-key-here
